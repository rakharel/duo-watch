name: Check iPhone Duo

on:
  schedule:
    # Busy window around the usual late-morning update (covers 11-12 Eastern in both EDT and EST)
    - cron: "*/5 14-18 * * *"
    # Rest of the day, less often
    - cron: "*/20 * * * *"
  workflow_dispatch:
    inputs:
      mode:
        description: "check, test, or discover"
        default: "test"

concurrency:
  group: duo-check
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run checker
        env:
          MODE: ${{ github.event.inputs.mode || 'check' }}
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
          TWILIO_ACCOUNT_SID: ${{ secrets.TWILIO_ACCOUNT_SID }}
          TWILIO_AUTH_TOKEN: ${{ secrets.TWILIO_AUTH_TOKEN }}
          TWILIO_FROM: ${{ secrets.TWILIO_FROM }}
          TWILIO_TO: ${{ secrets.TWILIO_TO }}
        run: python check_duo.py --mode "$MODE"

      - name: Save state
        if: always()
        run: |
          git config user.name "duo-watch-bot"
          git config user.email "duo-watch-bot@users.noreply.github.com"
          git add state.json 2>/dev/null || true
          git diff --cached --quiet || (git commit -m "update state" && git push)
